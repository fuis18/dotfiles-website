---
import './search.css';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import SearchIcon from './SearchIcon.astro';
import SearchBar from './SearchBar.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---
<button
class="icon-container"
type="button"
data-search-open
aria-haspopup="dialog"
aria-label={t(lang, 'search.open')}
title={t(lang, 'search.open')}
>
  <SearchIcon size="1.2rem" />
</button>

<dialog
  class="search-modal"
  id="search-modal"
  aria-label={t(lang, 'search.title')}
  data-no-results={t(lang, 'search.noResults')}
  data-count-label={t(lang, 'search.resultsCount')}
  data-dev-notice={t(lang, 'search.devNotice')}
>
  <div class="search-modal-inner">

    <SearchBar lang={lang} variant="modal" controls="pagefind-output" />

    <div id="pagefind-output" class="search-modal-output">
      <p
        class="search-modal-status"
        id="pagefind-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
      <ul id="pagefind-results" class="search-modal-results"></ul>
    </div>
  </div>
</dialog>

<script>
  interface PagefindSubResult {
    title?: string;
    url: string;
    excerpt?: string;
  }

  interface PagefindResultData {
    url: string;
    excerpt?: string;
    meta?: { title?: string };
    sub_results?: PagefindSubResult[];
  }

  interface PagefindResultStub {
    id: string;
    data(): Promise<PagefindResultData>;
  }

  interface PagefindSearchResponse {
    results: PagefindResultStub[];
  }

  interface PagefindApi {
    init(): Promise<void>;
    destroy?(): Promise<void>;
    preload(query: string): void;
    search(query: string, options?: Record<string, unknown>): Promise<PagefindSearchResponse>;
    debouncedSearch(
      query: string,
      options?: Record<string, unknown>,
      timeout?: number
    ): Promise<PagefindSearchResponse | null>;
  }

  const getModal = (): HTMLDialogElement | null =>
    document.getElementById('search-modal') as HTMLDialogElement | null;
  // The field is owned by <SearchBar variant="modal">: no hardcoded id.
  const getInput = (): HTMLInputElement | null =>
    document.querySelector<HTMLInputElement>('#search-modal [data-search-input]');
  const getStatus = (): HTMLElement | null => document.getElementById('pagefind-status');
  const getResults = (): HTMLElement | null => document.getElementById('pagefind-results');

  // The status node is never created or removed: only its text changes, so
  // the live region already exists when the announcement happens.
  function showStatus(text: string): void {
    const status = getStatus();
    if (status) status.textContent = text;
  }

  function setExpanded(expanded: boolean): void {
    getInput()?.setAttribute('aria-expanded', String(expanded));
  }

  function clearOutput(): void {
    // Drop aria-activedescendant before the nodes it points at disappear.
    setActive(-1);
    const results = getResults();
    if (results) results.innerHTML = '';
    showStatus('');
    setExpanded(false);
  }

  let pagefindPromise: Promise<PagefindApi | null> | null = null;
  let pagefindLang = '';
  let searchSeq = 0;
  let activeIndex = -1;

  /** Pagefind URLs are root-relative to dist/; the site may be served under a base path. */
  function withBase(url: string): string {
    const base = import.meta.env.BASE_URL;
    if (!base || base === '/') return url;
    return url.startsWith(base) ? url : `${base.replace(/\/$/, '')}${url}`;
  }

  async function loadPagefind(): Promise<PagefindApi | null> {
    const lang = document.documentElement.lang;
    // The index is per-language; re-init when a client-side navigation changes it.
    if (pagefindPromise && lang !== pagefindLang) {
      const previous = await pagefindPromise;
      if (previous?.destroy) await previous.destroy();
      pagefindPromise = null;
    }
    if (!pagefindPromise) {
      pagefindLang = lang;
      const base = import.meta.env.BASE_URL;
      const prefix = base.endsWith('/') ? base : `${base}/`;
      pagefindPromise = import(/* @vite-ignore */ `${prefix}pagefind/pagefind.js`)
        .then(async (mod) => {
          const api = mod as PagefindApi;
          await api.init();
          return api;
        })
        // No bundle in `astro dev` (or a failed build): fall back to the notice.
        .catch(() => null);
    }
    return pagefindPromise;
  }

  function buildTitle(text: string): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = 'search-result-title';
    span.textContent = text;
    return span;
  }

  function buildExcerpt(html?: string): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = 'search-result-excerpt';
    // Pagefind entity-encodes excerpts before adding <mark>: safe as innerHTML.
    span.innerHTML = html ?? '';
    return span;
  }

  function renderResults(items: PagefindResultData[]): void {
    const container = getResults();
    if (!container) return;
    setActive(-1);
    container.innerHTML = '';

    for (const item of items) {
      const li = document.createElement('li');
      li.className = 'search-result';

      const pageLink = document.createElement('a');
      pageLink.className = 'search-result-page';
      pageLink.href = withBase(item.url);
      pageLink.append(buildTitle(item.meta?.title ?? item.url), buildExcerpt(item.excerpt));
      li.append(pageLink);

      // Only sections whose excerpt actually contains the match: the exact fragment.
      const anchors = (item.sub_results ?? []).filter(
        (sub) => sub.url !== item.url && (sub.excerpt ?? '').includes('<mark>')
      );
      if (anchors.length > 0) {
        const subList = document.createElement('ul');
        subList.className = 'search-result-anchors';
        for (const sub of anchors.slice(0, 6)) {
          const subLi = document.createElement('li');
          const subLink = document.createElement('a');
          subLink.className = 'search-result-anchor';
          subLink.href = withBase(sub.url);
          subLink.append(buildTitle(sub.title ?? sub.url), buildExcerpt(sub.excerpt));
          subLi.append(subLink);
          subList.append(subLi);
        }
        li.append(subList);
      }

      container.append(li);
    }

    // aria-activedescendant needs a stable id per link.
    resultLinks().forEach((link, i) => {
      link.id = `search-link-${i}`;
    });
    setActive(-1);
  }

  function resultLinks(): HTMLAnchorElement[] {
    const container = getResults();
    return container ? Array.from(container.querySelectorAll('a')) : [];
  }

  function setActive(index: number): void {
    const links = resultLinks();
    const input = getInput();

    links.forEach((link) => {
      link.classList.remove('is-active');
      link.removeAttribute('aria-current');
    });

    if (links.length === 0 || index < 0) {
      activeIndex = -1;
      input?.removeAttribute('aria-activedescendant');
      return;
    }

    activeIndex = Math.min(index, links.length - 1);
    const active = links[activeIndex];
    active.classList.add('is-active');
    active.setAttribute('aria-current', 'true');
    input?.setAttribute('aria-activedescendant', active.id);
    active.scrollIntoView({ block: 'nearest' });
  }

  async function runSearch(query: string): Promise<void> {
    const seq = ++searchSeq;
    const modal = getModal();
    if (!modal) return;

    if (query === '') {
      clearOutput();
      return;
    }

    try {
      const api = await loadPagefind();
      if (seq !== searchSeq) return;
      if (!api) {
        clearOutput();
        showStatus(modal.dataset.devNotice ?? '');
        return;
      }

      api.preload(query);
      const search = await api.debouncedSearch(query, {}, 150);
      if (!search || seq !== searchSeq) return;

      if (search.results.length === 0) {
        clearOutput();
        showStatus(modal.dataset.noResults ?? '');
        return;
      }

      const items = await Promise.all(search.results.slice(0, 10).map((r) => r.data()));
      if (seq !== searchSeq) return;

      renderResults(items);
      showStatus(`${search.results.length} ${modal.dataset.countLabel ?? ''}`);
      setExpanded(true);
    } catch {
      if (seq === searchSeq) {
        clearOutput();
        showStatus(modal.dataset.devNotice ?? '');
      }
    }
  }

  function openModal(): void {
    const modal = getModal();
    if (!modal) return;
    const input = getInput();
    if (input) input.value = '';
    clearOutput();
    if (!modal.open) modal.showModal();
    input?.focus();
    // Warm up the index while the user types.
    void loadPagefind();
  }

  // Delegated on document: the ClientRouter swaps the body on navigation, while
  // this bundled module and its document-level listeners survive.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('[data-search-open]')) {
      event.preventDefault();
      openModal();
      return;
    }
    const modal = getModal();
    if (modal?.open && target === modal) modal.close();
  });

  document.addEventListener('input', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('#search-modal')) return;
    if (!target.matches('[data-search-input]')) return;
    void runSearch((target as HTMLInputElement).value.trim());
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const modal = getModal();
    const isTyping =
      target?.tagName === 'INPUT' ||
      target?.tagName === 'TEXTAREA' ||
      target?.isContentEditable === true;

    if (event.key === '/' && !isTyping) {
      if (modal && !modal.open) {
        event.preventDefault();
        openModal();
      } else if (modal?.open) {
        event.preventDefault();
        getInput()?.focus();
      }
      return;
    }

    if (!modal?.open) return;
    if (target !== getInput()) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      modal.close();
      return;
    }

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const links = resultLinks();
      if (links.length === 0) return;
      const delta = event.key === 'ArrowDown' ? 1 : -1;
      const next = activeIndex === -1 ? (delta > 0 ? 0 : links.length - 1) : activeIndex + delta;
      setActive(next);
      return;
    }

    if (event.key === 'Enter') {
      const links = resultLinks();
      const link = links[activeIndex >= 0 ? activeIndex : 0];
      if (link) {
        event.preventDefault();
        link.click();
      }
    }
  });
</script>

