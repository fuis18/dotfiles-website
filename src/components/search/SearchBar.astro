---
import '@/styles/search.css';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import SearchIcon from './SearchIcon.astro';

interface Props {
  lang: Locale;
  id?: string;
  variant?: 'bar' | 'header' | 'modal';
  kbd?: string;
  controls?: string;
}

const { lang, id, variant = 'bar', kbd, controls } = Astro.props;
const isModal = variant === 'modal';
const isTrigger = !isModal;
const hint = kbd ?? (isModal ? 'esc' : '/');
const inputId = id ?? (isModal ? 'search-modal-input' : 'search-bar-input');
---
<div
  class:list={[
    'search-bar',
    isModal && 'search-bar--modal',
    variant === 'header' && 'search-bar--header',
  ]}
>
  <SearchIcon size="1rem" />
  <label class="search-sr-only" for={inputId}>{t(lang, 'nav.search')}</label>
  <input
    type="search"
    id={inputId}
    class="search-bar-input"
    placeholder={t(lang, 'search.placeholder')}
    autocomplete="off"
    spellcheck="false"
    data-search-input={isModal ? '' : undefined}
    data-search-open={isTrigger ? '' : undefined}
    data-search-trigger={isTrigger ? '' : undefined}
    aria-haspopup={isTrigger ? 'dialog' : undefined}
    aria-expanded={isModal || isTrigger ? 'false' : undefined}
    role={isModal ? 'combobox' : undefined}
    aria-autocomplete={isModal ? 'list' : undefined}
    aria-controls={isModal ? controls : undefined}
  />
  <span class="search-kbd search-bar-kbd" aria-hidden="true">{hint}</span>
</div>
